# Copy to .env, fill in, then: chmod 600 .env
# Never commit .env. Never paste these values into chats or issues.

# Telegram: token from @BotFather; chat IDs from `make tg-whoami`
TELEGRAM_BOT_TOKEN=replace-me
# Comma-separated list of chat IDs allowed to receive calls and press buttons
TELEGRAM_ALLOWED_CHAT_IDS=123456789

# Dhan (data APIs only; order placement stays disabled)
DHAN_CLIENT_ID=replace-me
DHAN_ACCESS_TOKEN=replace-me
